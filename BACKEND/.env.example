# Backend environment template
# Copy to .env and fill values

NODE_ENV=development
PORT=5000

# CORS
FRONTEND_URL=http://localhost:5173

# Database
# server.js uses MONGO_URI
MONGO_URI=mongodb://127.0.0.1:27017/ai_campaign_assistant
# config/db.js uses MONGODB_URI (keep in sync if you use connectDB helper)
MONGODB_URI=mongodb://127.0.0.1:27017/ai_campaign_assistant

# Auth
JWT_SECRET=replace_with_a_long_random_secret

# OpenAI
OPENAI_API_KEY=replace_with_openai_api_key

# Facebook App
FACEBOOK_APP_ID=replace_with_facebook_app_id
FACEBOOK_APP_SECRET=replace_with_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:5173/onboarding

# Email (Gmail SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
